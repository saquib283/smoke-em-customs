# ──────────────────────────── Database ────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smokecustoms

# ──────────────────────────── Auth ────────────────────────────
AUTH_SECRET=your-secret-key-here-change-in-production
AUTH_URL=http://localhost:3000

# ──────────────────────────── Storage (Vercel Blob / Local / S3) ────────────────────────────
# Set to 'vercel-blob' for Vercel production deployment.
# When deployed on Vercel with a Blob Store linked, BLOB_READ_WRITE_TOKEN is injected automatically.
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=vercel-blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional S3 Storage configuration:
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_CDN_URL=

# ──────────────────────────── WhatsApp Cloud API ────────────────────────────
WHATSAPP_BUSINESS_PHONE=919876543210
WHATSAPP_API_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-system-user-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=smoke_customs_whatsapp_verify_token_2024
WHATSAPP_APP_SECRET=your-meta-app-secret

# ──────────────────────────── Recommendation ────────────────────────────
RECOMMENDATION_ENGINE=rules

# ──────────────────────────── Booking ────────────────────────────
BOOKING_DEFAULT_BUFFER_MINUTES=15
BOOKING_MIN_LEAD_TIME_MINUTES=120
BOOKING_SLOT_GRANULARITY_MINUTES=30

# ──────────────────────────── Rate Limiting ────────────────────────────
RATE_LIMIT_STORE=memory

# ──────────────────────────── Email Engine (Brevo / Gmail / Resend / Simulated) ────────────────────────────
EMAIL_PROVIDER_TYPE=SIMULATED
# For Custom SMTP (e.g., Brevo 300 free/day, Gmail, Mailgun, Amazon SES):
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-account-email
SMTP_PASSWORD=your-smtp-master-key
SMTP_FROM_EMAIL=concierge@smokecustoms.com
SMTP_FROM_NAME="Smoke M Customs"
# For Resend Cloud API:
# RESEND_API_KEY=re_your_api_key_here

# ──────────────────────────── Logging ────────────────────────────
LOG_LEVEL=info
