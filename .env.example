# ──────────────────────────── Database ────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smokecustoms

# ──────────────────────────── Auth ────────────────────────────
AUTH_SECRET=your-secret-key-here-change-in-production
AUTH_URL=http://localhost:3000

# ──────────────────────────── Storage ────────────────────────────
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_CDN_URL=

# ──────────────────────────── WhatsApp ────────────────────────────
WHATSAPP_BUSINESS_PHONE=919876543210
WHATSAPP_API_ENABLED=false
# WHATSAPP_API_TOKEN=

# ──────────────────────────── Recommendation ────────────────────────────
RECOMMENDATION_ENGINE=rules

# ──────────────────────────── Booking ────────────────────────────
BOOKING_DEFAULT_BUFFER_MINUTES=15
BOOKING_MIN_LEAD_TIME_MINUTES=120
BOOKING_SLOT_GRANULARITY_MINUTES=30

# ──────────────────────────── Rate Limiting ────────────────────────────
RATE_LIMIT_STORE=memory

# ──────────────────────────── Logging ────────────────────────────
LOG_LEVEL=info
